# Copy this file to .env and fill in your values. NEVER commit .env
PORT=5000

# MongoDB (products)
MONGO_URI=mongodb://127.0.0.1:27017/mern_test

# MySQL (users, orders)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mern_test

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Third-party API (Open-Meteo, no API key needed)
DEFAULT_CITY=Mumbai
